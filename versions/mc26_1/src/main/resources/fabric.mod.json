{
  "schemaVersion": 1,
  "id": "oldlightmap",
  "version": "${version}",
  "name": "Old Lightmap",
  "icon": "assets/oldlightmap/textures/icon.png",
  "description": "Restores the 1.21.8 lightmap algorithm on Minecraft 26.1.x.",
  "authors": [
    "BrokenDream_Star"
  ],
  "contact": {
    "homepage": "https://github.com/BrokenDreamStar/OldLightmap",
    "sources": "https://github.com/BrokenDreamStar/OldLightmap"
  },
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "sodium:config_api_user": [
      "oldlightmap.sodium.OldLightmapSodiumConfig"
    ]
  },
  "mixins": [
    "oldlightmap.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "${minecraft_dependency}"
  },
  "suggests": {
    "sodium": "*"
  }
}
